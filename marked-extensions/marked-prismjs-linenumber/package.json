{
  "name": "marked-prismjs-linenumber",
  "version": "0.0.8",
  "description": "Return HTML with prismjs line-number structure",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yz0012/y_z00blog/tree/main/marked-extensions/marked-prismjs-linenumber"
  },
  "peerDependencies": {
    "marked": ">=4",
    "prismjs": "^1.29.0"
  },
  "keywords": [
    "marked",
    "prismjs",
    "linenumber"
  ],
  "author": "Y_z00",
  "license": "MIT"
}